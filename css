#nav-bar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    gap: 0;
    margin-top: var(--card-gap);
    height: 9vh;
    min-height: 44px;
    max-height: 60px;
    flex-shrink: 0;
}

.nav-btn {
    flex: 1;
    margin: 0 1px;
    border-radius: 8px;
    border: none;
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
    touch-action: manipulation;
    font-size: 0.9rem;
}

/* Undo button on far right can be visually distinct later if desired */
#nav-undo-btn {
    font-size: 1.4rem;
}
